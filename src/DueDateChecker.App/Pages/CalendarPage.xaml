<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:DueDateChecker.App.ViewModels"
             x:Class="DueDateChecker.App.Pages.CalendarPage"
             xmlns:pages="clr-namespace:DueDateChecker.App.Pages"
             x:DataType="vm:CalendarViewModel" Title="Calendar" Shell.NavBarIsVisible="False">
    <Grid x:Name="PageContent">
        <CollectionView x:Name="Results" ItemsSource="{Binding Agenda}" SelectionMode="Single"
                        SelectionChanged="OnDueSelected"
                        SemanticProperties.Description="Saved dues for the selected day; select one for details">
            <CollectionView.Header>
                <VerticalStackLayout Spacing="20" Padding="0,8,0,0">
                    <pages:RootHeader RemindersClicked="OnRemindersClicked" />
                    <VerticalStackLayout Spacing="6">
                        <Label x:Name="Heading" Text="A date for everything." Style="{StaticResource Heading1}" />
                        <Label Text="Find your day. See what's on it." Style="{StaticResource CaptionLabel}" />
                    </VerticalStackLayout>
                    <VerticalStackLayout Spacing="8" IsVisible="{Binding IsBusy}">
                        <ActivityIndicator IsRunning="{Binding IsBusy}" SemanticProperties.Description="Loading saved calendar dues" />
                        <Label Text="Loading your calendar…" Style="{StaticResource SupportingLabel}" />
                    </VerticalStackLayout>
                    <Border Style="{StaticResource SurfaceCard}" IsVisible="{Binding HasError}">
                        <VerticalStackLayout Spacing="12">
                            <Label Text="{Binding ErrorMessage}" Style="{StaticResource ErrorLabel}" />
                            <Button Text="Refresh / Retry" Command="{Binding LoadCommand}" Style="{StaticResource SecondaryButton}" HorizontalOptions="Start" />
                        </VerticalStackLayout>
                    </Border>
                    <VerticalStackLayout Spacing="10">
                        <!-- Prototype calendar controls (PA06): month on the left, previous and next on the right. -->
                        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="4">
                            <Label Text="{Binding MonthText}" Style="{StaticResource Heading2}" VerticalOptions="Center" AutomationId="CalendarMonth" />
                            <Grid Grid.Column="1" WidthRequest="44" HeightRequest="44" IsEnabled="{Binding CanGoPrevious}">
                                <pages:Glyph Kind="back" HorizontalOptions="Center" VerticalOptions="Center"
                                             Color="{AppThemeBinding Light={StaticResource TextLight}, Dark={StaticResource TextDark}}" />
                                <Button Style="{StaticResource OverlayButton}" Clicked="OnPreviousClicked" IsEnabled="{Binding CanGoPrevious}"
                                        SemanticProperties.Description="Previous month" AutomationId="CalendarPrevious" />
                            </Grid>
                            <Grid Grid.Column="2" WidthRequest="44" HeightRequest="44">
                                <pages:Glyph Kind="next" HorizontalOptions="Center" VerticalOptions="Center"
                                             Color="{AppThemeBinding Light={StaticResource TextLight}, Dark={StaticResource TextDark}}" />
                                <Button Style="{StaticResource OverlayButton}" Clicked="OnNextClicked" IsEnabled="{Binding CanGoNext}"
                                        SemanticProperties.Description="Next month" AutomationId="CalendarNext" />
                            </Grid>
                        </Grid>
                        <!-- UX15 (decided 2026-11-06, option B): no sideways scroll. Seven 44 dp columns where they fit;
                             on narrower rows the cells share the width (code-behind, LayoutRules.DayCellMinimumWidth). -->
                        <Grid x:Name="MonthGrid" ColumnDefinitions="*,*,*,*,*,*,*" RowSpacing="4" ColumnSpacing="2" />
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                            <Label Text="{Binding WeekStartDescription}" Style="{StaticResource CaptionLabel}" VerticalOptions="Center"
                                   AutomationId="CalendarWeekStart" />
                            <Grid Grid.Column="1" MinimumHeightRequest="44">
                                <HorizontalStackLayout Spacing="6" VerticalOptions="Center" InputTransparent="True">
                                    <Label Text="Today" FontFamily="JakartaMedium" FontSize="14" VerticalOptions="Center"
                                           AutomationProperties.IsInAccessibleTree="False"
                                           TextColor="{AppThemeBinding Light={StaticResource TextLight}, Dark={StaticResource TextDark}}" />
                                    <pages:Glyph Kind="calendar" Size="18" VerticalOptions="Center"
                                                 Color="{AppThemeBinding Light={StaticResource TextLight}, Dark={StaticResource TextDark}}" />
                                </HorizontalStackLayout>
                                <Button Style="{StaticResource OverlayButton}" Clicked="OnTodayClicked"
                                        SemanticProperties.Description="{Binding TodayDescription}" AutomationId="CalendarToday" />
                            </Grid>
                        </Grid>
                    </VerticalStackLayout>
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                        <Label Text="{Binding SelectedDateText}" Style="{StaticResource Heading3}" VerticalOptions="Center"
                               AutomationId="CalendarSelectedDate" SemanticProperties.HeadingLevel="Level2" />
                        <Label Grid.Column="1" Text="{Binding AgendaSummary}" IsVisible="{Binding HasLoaded}" Style="{StaticResource CaptionLabel}"
                               VerticalOptions="Center" AutomationId="CalendarAgendaSummary" />
                    </Grid>
                    <Border Style="{StaticResource SurfaceCard}" IsVisible="{Binding IsEmpty}">
                        <VerticalStackLayout Spacing="8">
                            <Label Text="Your first due starts here." Style="{StaticResource Heading2}" />
                            <Label Text="Tap Add in the bottom bar to create your first due. Your saved information stays available offline." />
                        </VerticalStackLayout>
                    </Border>
                    <Border Style="{StaticResource NoticeCard}" IsVisible="{Binding IsDayEmpty}">
                        <Label Text="Nothing due. A little breathing room." />
                    </Border>
                    <BoxView Style="{StaticResource Divider}" IsVisible="{Binding HasLoaded}" />
                </VerticalStackLayout>
            </CollectionView.Header>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="vm:DashboardItem">
                    <pages:DueRow />
                </DataTemplate>
            </CollectionView.ItemTemplate>
            <CollectionView.Footer>
                <Label Text="Add defaults to Today, independently of this selected date." Style="{StaticResource CaptionLabel}"
                       Margin="0,16,0,24" />
            </CollectionView.Footer>
        </CollectionView>
    </Grid>
</ContentPage>
