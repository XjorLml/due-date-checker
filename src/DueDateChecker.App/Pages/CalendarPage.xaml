<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:DueDateChecker.App.ViewModels"
             x:Class="DueDateChecker.App.Pages.CalendarPage"
             xmlns:pages="clr-namespace:DueDateChecker.App.Pages"
             x:DataType="vm:CalendarViewModel" Title="Calendar" Shell.NavBarIsVisible="False">
    <Grid x:Name="PageContent">
        <CollectionView x:Name="Results" ItemsSource="{Binding Agenda}" SelectionMode="Single"
                        SelectionChanged="OnDueSelected"
                        SemanticProperties.Description="Saved dues for the selected day; select one for details">
            <CollectionView.Header>
                <VerticalStackLayout Spacing="20" Padding="0,8,0,0">
                    <VerticalStackLayout Spacing="6">
                        <Label Text="A date for everything." Style="{StaticResource Heading1}" />
                        <Label Text="Find your day. See what's on it. Dates use Asia/Manila." Style="{StaticResource CaptionLabel}" />
                    </VerticalStackLayout>
                    <VerticalStackLayout Spacing="8" IsVisible="{Binding IsBusy}">
                        <ActivityIndicator IsRunning="{Binding IsBusy}" SemanticProperties.Description="Loading saved calendar dues" />
                        <Label Text="Loading your calendar…" Style="{StaticResource SupportingLabel}" />
                    </VerticalStackLayout>
                    <Border Style="{StaticResource SurfaceCard}" IsVisible="{Binding HasError}">
                        <VerticalStackLayout Spacing="12">
                            <Label Text="{Binding ErrorMessage}" Style="{StaticResource ErrorLabel}" />
                            <Button Text="Refresh / Retry" Command="{Binding LoadCommand}" Style="{StaticResource SecondaryButton}" HorizontalOptions="Start" />
                        </VerticalStackLayout>
                    </Border>
                    <VerticalStackLayout Spacing="8">
                        <!-- Focus calendar controls: month on the left, arrows and Today on the right. -->
                        <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="2">
                            <Label Text="{Binding MonthText}" Style="{StaticResource Heading2}" VerticalOptions="Center" AutomationId="CalendarMonth" />
                            <Button Grid.Column="1" Text="‹" Style="{StaticResource IconButton}" Clicked="OnPreviousClicked"
                                    IsEnabled="{Binding CanGoPrevious}" SemanticProperties.Description="Previous month" AutomationId="CalendarPrevious" />
                            <Button Grid.Column="2" Text="›" Style="{StaticResource IconButton}" Clicked="OnNextClicked"
                                    IsEnabled="{Binding CanGoNext}" SemanticProperties.Description="Next month" AutomationId="CalendarNext" />
                            <Button Grid.Column="3" Text="Today" Style="{StaticResource FilterChip}" Clicked="OnTodayClicked"
                                    SemanticProperties.Description="{Binding TodayDescription}" AutomationId="CalendarToday" />
                        </Grid>
                        <Label Text="{Binding WeekStartDescription}" Style="{StaticResource CaptionLabel}" AutomationId="CalendarWeekStart" />
                        <ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Default">
                            <Grid x:Name="MonthGrid" MinimumWidthRequest="322" ColumnDefinitions="*,*,*,*,*,*,*" RowSpacing="4" ColumnSpacing="2" />
                        </ScrollView>
                    </VerticalStackLayout>
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                        <Label Text="{Binding SelectedDateText}" Style="{StaticResource Heading3}" VerticalOptions="Center" AutomationId="CalendarSelectedDate" />
                        <Label Grid.Column="1" Text="{Binding AgendaSummary}" IsVisible="{Binding HasLoaded}" Style="{StaticResource CaptionLabel}"
                               VerticalOptions="Center" AutomationId="CalendarAgendaSummary" />
                    </Grid>
                    <Border Style="{StaticResource SurfaceCard}" IsVisible="{Binding IsEmpty}">
                        <VerticalStackLayout Spacing="8">
                            <Label Text="Your first due starts here." Style="{StaticResource Heading2}" />
                            <Label Text="Tap Add in the bottom bar to create your first due. Your saved information stays available offline." />
                        </VerticalStackLayout>
                    </Border>
                    <Border Style="{StaticResource SurfaceCard}" IsVisible="{Binding IsDayEmpty}">
                        <VerticalStackLayout Spacing="8">
                            <Label Text="Nothing due on this day." Style="{StaticResource Heading2}" />
                            <Label Text="Choose another date or add a due." />
                        </VerticalStackLayout>
                    </Border>
                    <BoxView Style="{StaticResource Divider}" IsVisible="{Binding HasLoaded}" />
                </VerticalStackLayout>
            </CollectionView.Header>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="vm:DashboardItem">
                    <pages:DueRow />
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>
