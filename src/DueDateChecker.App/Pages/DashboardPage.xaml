<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:DueDateChecker.App.ViewModels"
             xmlns:pages="clr-namespace:DueDateChecker.App.Pages"
             x:Class="DueDateChecker.App.Pages.DashboardPage"
             x:DataType="vm:DashboardViewModel" Title="Dashboard" Shell.NavBarIsVisible="False">
    <Grid x:Name="PageContent">
        <CollectionView x:Name="Results" ItemsSource="{Binding Items}" SelectionMode="Single"
                        SelectionChanged="OnDueSelected"
                        SemanticProperties.Description="Saved dues matching your search and status filter; select one for details">
            <CollectionView.Header>
                <VerticalStackLayout Spacing="20" Padding="0,8,0,0">
                    <VerticalStackLayout Spacing="6">
                        <Label Text="A clear plan for today." Style="{StaticResource Heading1}" />
                        <Label Text="{Binding DateText}" Style="{StaticResource CaptionLabel}" />
                    </VerticalStackLayout>
                    <VerticalStackLayout Spacing="8" IsVisible="{Binding IsBusy}">
                        <ActivityIndicator IsRunning="{Binding IsBusy}" SemanticProperties.Description="Loading saved dashboard dues" />
                        <Label Text="Loading your dashboard…" Style="{StaticResource SupportingLabel}" />
                    </VerticalStackLayout>
                    <Border Style="{StaticResource SurfaceCard}" IsVisible="{Binding HasError}">
                        <VerticalStackLayout Spacing="12">
                            <Label Text="{Binding ErrorMessage}" Style="{StaticResource ErrorLabel}" />
                            <Button Text="Refresh / Retry" Command="{Binding LoadCommand}" Style="{StaticResource SecondaryButton}" HorizontalOptions="Start" />
                        </VerticalStackLayout>
                    </Border>
                    <!-- Focus summary: month total, next due, three counters that double as quick filters. -->
                    <VerticalStackLayout Spacing="4" IsVisible="{Binding HasLoaded}" AutomationId="DashboardSummary">
                        <Label Text="{Binding MonthLabel}" Style="{StaticResource CaptionLabel}" FontFamily="JakartaSemibold" />
                        <Label Text="{Binding UpcomingTotalText}" Style="{StaticResource HeroAmount}" AutomationId="DashboardUpcomingTotal"
                               SemanticProperties.Description="{Binding UpcomingDescription}" />
                        <Label Text="{Binding UpcomingMetaText}" Style="{StaticResource SupportingLabel}" />
                        <BoxView Style="{StaticResource Divider}" Margin="0,10,0,0" />
                        <Label Text="{Binding NextDateText}" Style="{StaticResource CaptionLabel}" Margin="0,10,0,0" AutomationId="DashboardNextDate" />
                        <Button Text="{Binding NextTitle}" IsVisible="{Binding HasNext}" Style="{StaticResource LinkButton}" HorizontalOptions="Start"
                                Clicked="OnNextClicked" AutomationId="DashboardNext" SemanticProperties.Hint="Opens the next due's details" />
                        <Grid ColumnDefinitions="*,*,*" ColumnSpacing="7" Margin="0,8,0,0">
                            <Border Style="{StaticResource CounterCard}" AutomationId="DashboardCounterOverdue"
                                    SemanticProperties.Description="{Binding OverdueCount, StringFormat='{0} overdue. Shows overdue dues'}">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnCounterTapped" CommandParameter="Overdue" />
                                </Border.GestureRecognizers>
                                <VerticalStackLayout Spacing="0" HorizontalOptions="Center">
                                    <Label Text="{Binding OverdueCount}" FontFamily="JakartaBold" FontSize="16" HorizontalTextAlignment="Center"
                                           TextColor="{AppThemeBinding Light={StaticResource DestructiveLight}, Dark={StaticResource DestructiveDark}}" />
                                    <Label Text="Overdue" Style="{StaticResource CaptionLabel}" HorizontalTextAlignment="Center" />
                                </VerticalStackLayout>
                            </Border>
                            <Border Grid.Column="1" Style="{StaticResource CounterCard}" AutomationId="DashboardCounterToday"
                                    SemanticProperties.Description="{Binding TodayCount, StringFormat='{0} due today. Shows dues due today'}">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnCounterTapped" CommandParameter="Due today" />
                                </Border.GestureRecognizers>
                                <VerticalStackLayout Spacing="0" HorizontalOptions="Center">
                                    <Label Text="{Binding TodayCount}" FontFamily="JakartaBold" FontSize="16" HorizontalTextAlignment="Center"
                                           TextColor="{AppThemeBinding Light={StaticResource DueSoonLight}, Dark={StaticResource DueSoonDark}}" />
                                    <Label Text="Today" Style="{StaticResource CaptionLabel}" HorizontalTextAlignment="Center" />
                                </VerticalStackLayout>
                            </Border>
                            <Border Grid.Column="2" Style="{StaticResource CounterCard}" AutomationId="DashboardCounterPaid"
                                    SemanticProperties.Description="{Binding ProgressDescription, StringFormat='{0}. Shows paid dues'}">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnCounterTapped" CommandParameter="Paid" />
                                </Border.GestureRecognizers>
                                <VerticalStackLayout Spacing="0" HorizontalOptions="Center">
                                    <Label Text="{Binding PaidCounterText}" FontFamily="JakartaBold" FontSize="16" HorizontalTextAlignment="Center"
                                           TextColor="{AppThemeBinding Light={StaticResource CompletedLight}, Dark={StaticResource CompletedDark}}" />
                                    <Label Text="Paid" Style="{StaticResource CaptionLabel}" HorizontalTextAlignment="Center" />
                                </VerticalStackLayout>
                            </Border>
                        </Grid>
                        <Label Text="Counts cover all saved dues. The total covers known unpaid amounts from today to month end."
                               Style="{StaticResource CaptionLabel}" Margin="0,4,0,0" />
                    </VerticalStackLayout>
                    <VerticalStackLayout Spacing="10">
                        <Label Text="Find a due" Style="{StaticResource Heading3}" />
                        <Border Style="{StaticResource FieldBorder}">
                            <Entry x:Name="SearchEntry" Text="{Binding Query}" Placeholder="Search a bill or task"
                                   ReturnType="Search" ClearButtonVisibility="WhileEditing" AutomationId="DashboardSearch"
                                   SemanticProperties.Description="Search saved due titles" />
                        </Border>
                        <Border Style="{StaticResource FieldBorder}">
                            <Picker Title="Category" ItemsSource="{Binding CategoryFilters}" SelectedItem="{Binding CategoryFilter}"
                                    AutomationId="DashboardCategory" SemanticProperties.Description="Filter saved dues by category" />
                        </Border>
                        <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="*,*,*" RowSpacing="6" ColumnSpacing="6"
                              SemanticProperties.Description="Status filter">
                            <Button x:Name="AllFilter" Text="All" CommandParameter="All" Clicked="OnFilterClicked" />
                            <Button x:Name="OverdueFilter" Grid.Column="1" Text="Overdue" CommandParameter="Overdue" Clicked="OnFilterClicked" />
                            <Button x:Name="TodayFilter" Grid.Column="2" Text="Due today" CommandParameter="Due today" Clicked="OnFilterClicked" />
                            <Button x:Name="UpcomingFilter" Grid.Row="1" Text="Upcoming" CommandParameter="Upcoming" Clicked="OnFilterClicked" />
                            <Button x:Name="PaidFilter" Grid.Row="1" Grid.Column="1" Text="Paid" CommandParameter="Paid" Clicked="OnFilterClicked" />
                        </Grid>
                        <Button Text="Clear filters" Command="{Binding ClearFiltersCommand}" IsEnabled="{Binding HasFilters}"
                                Style="{StaticResource LinkButton}" HorizontalOptions="Start" />
                    </VerticalStackLayout>
                    <Label Text="{Binding ResultsHeading}" IsVisible="{Binding HasLoaded}" Style="{StaticResource Heading3}"
                           AutomationId="DashboardResults" />
                    <!-- Keep these in the persistent header. Android swaps the adapter
                         for CollectionView.EmptyView, which destroys focused search. -->
                    <Border Style="{StaticResource SurfaceCard}" IsVisible="{Binding IsEmpty}">
                        <VerticalStackLayout Spacing="12">
                            <Label Text="Your first due starts here." Style="{StaticResource Heading2}" />
                            <Label Text="Tap Add in the bottom bar to add a bill, subscription or task. Your saved information stays available offline." />
                        </VerticalStackLayout>
                    </Border>
                    <Border Style="{StaticResource SurfaceCard}" IsVisible="{Binding IsNoMatches}">
                        <VerticalStackLayout Spacing="12">
                            <Label Text="Nothing matches just yet." Style="{StaticResource Heading2}" />
                            <Label Text="Try another title, category or status." />
                            <Button Text="Show all dues" Command="{Binding ClearFiltersCommand}" HorizontalOptions="Start" />
                        </VerticalStackLayout>
                    </Border>
                    <BoxView Style="{StaticResource Divider}" IsVisible="{Binding HasLoaded}" />
                </VerticalStackLayout>
            </CollectionView.Header>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="vm:DashboardItem">
                    <pages:DueRow />
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>
