<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:DueDateChecker.App.ViewModels"
             xmlns:pages="clr-namespace:DueDateChecker.App.Pages"
             x:Class="DueDateChecker.App.Pages.DueEditPage"
             x:DataType="vm:DueEditViewModel" Title="{Binding PageTitle}"
             Shell.NavBarIsVisible="False" Shell.TabBarIsVisible="False">
    <Shell.BackButtonBehavior>
        <BackButtonBehavior IsEnabled="{Binding IsIdle}" />
    </Shell.BackButtonBehavior>
    <!-- Prototype editor (PA07, Essential-first with sticky actions): title and bin in the header; title,
         type (UX11 keeps it before Amount), amount and date first; Repeat and Notes as collapsible rows;
         Cancel/Save fixed below the fields. Leaving with changes asks first (UX22, code-behind).
         SafeAreaEdges (left, top, right, bottom): only the bottom edge pads for the on-screen keyboard,
         so Cancel/Save sit above it; this works with the Resize soft-input mode set in code-behind. -->
    <Grid RowDefinitions="Auto,*,Auto" SafeAreaEdges="None,None,None,SoftInput">
        <pages:PushedHeader Title="{Binding PageTitle}" ShowBack="False" ActionKind="trash" ActionIsDestructive="True"
                            ActionDescription="Delete due" ActionVisible="{Binding ShowDelete}" ActionEnabled="{Binding CanDelete}"
                            ActionClicked="OnDeleteClicked" Padding="8,0" />
        <ScrollView Grid.Row="1">
            <VerticalStackLayout x:Name="PageContent" Spacing="20">
                <Label Text="Required fields are marked." Style="{StaticResource SupportingLabel}" />

                <VerticalStackLayout Spacing="8">
                    <Label Style="{StaticResource FieldLabel}">
                        <Label.FormattedText>
                            <FormattedString>
                                <Span Text="What is due? " />
                                <Span Text="required" FontFamily="JakartaRegular" FontSize="13"
                                      TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" />
                            </FormattedString>
                        </Label.FormattedText>
                    </Label>
                    <Border Style="{StaticResource FieldBorder}">
                        <Border.Triggers>
                            <DataTrigger TargetType="Border" Binding="{Binding Source={x:Reference TitleEntry}, Path=IsFocused}" Value="True">
                                <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource FocusLight}, Dark={StaticResource FocusDark}}" />
                                <Setter Property="StrokeThickness" Value="3" />
                            </DataTrigger>
                            <DataTrigger TargetType="Border" Binding="{Binding HasTitleError}" Value="True">
                                <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource DestructiveLight}, Dark={StaticResource DestructiveDark}}" />
                                <Setter Property="StrokeThickness" Value="3" />
                            </DataTrigger>
                        </Border.Triggers>
                        <Entry x:Name="TitleEntry" Text="{Binding Title}" Placeholder="e.g. Electricity bill"
                               IsEnabled="{Binding CanEdit}" Unfocused="OnTitleUnfocused"
                               SemanticProperties.Description="Due title, required" />
                    </Border>
                    <Label Text="{Binding TitleError}" IsVisible="{Binding HasTitleError}" Style="{StaticResource ErrorLabel}" />
                </VerticalStackLayout>

                <!-- UX11: Type stays right after the title, drawn as the prototype's compact "Type: Bill · Change" row. -->
                <VerticalStackLayout Spacing="4">
                    <Grid ColumnDefinitions="*,Auto" MinimumHeightRequest="44">
                        <Label Text="{Binding TypeRowText}" FontFamily="JakartaSemibold" FontSize="15" VerticalOptions="Center" AutomationId="DueTypeRow"
                               TextColor="{AppThemeBinding Light={StaticResource TextLight}, Dark={StaticResource TextDark}}" />
                        <Button Grid.Column="1" x:Name="ChangeTypeButton" Text="Change" Style="{StaticResource LinkButton}" Clicked="OnChangeTypeClicked"
                                IsEnabled="{Binding CanEdit}" AutomationId="DueCategory"
                                SemanticProperties.Description="{Binding TypeRowText, StringFormat='{0}. Change due type'}" />
                    </Grid>
                    <Label Text="{Binding CategoryError}" IsVisible="{Binding HasCategoryError}" Style="{StaticResource ErrorLabel}" />
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="8">
                    <Label Style="{StaticResource FieldLabel}">
                        <Label.FormattedText>
                            <FormattedString>
                                <Span Text="Amount (PHP) " />
                                <Span Text="{Binding AmountFieldTag}" FontFamily="JakartaRegular" FontSize="13"
                                      TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" />
                            </FormattedString>
                        </Label.FormattedText>
                    </Label>
                    <Border Style="{StaticResource FieldBorder}">
                        <Border.Triggers>
                            <DataTrigger TargetType="Border" Binding="{Binding Source={x:Reference AmountEntry}, Path=IsFocused}" Value="True">
                                <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource FocusLight}, Dark={StaticResource FocusDark}}" />
                                <Setter Property="StrokeThickness" Value="3" />
                            </DataTrigger>
                            <DataTrigger TargetType="Border" Binding="{Binding HasAmountError}" Value="True">
                                <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource DestructiveLight}, Dark={StaticResource DestructiveDark}}" />
                                <Setter Property="StrokeThickness" Value="3" />
                            </DataTrigger>
                        </Border.Triggers>
                        <Entry x:Name="AmountEntry" Text="{Binding AmountText}" Keyboard="Numeric" Placeholder="{Binding AmountPlaceholder}"
                               IsEnabled="{Binding CanEdit}" Unfocused="OnAmountUnfocused"
                               SemanticProperties.Description="{Binding AmountDescription}" AutomationId="DueAmount" />
                    </Border>
                    <!-- F07 optional amounts: the requirement follows the Type chosen above (Bill by default). -->
                    <Label Text="{Binding AmountRequirementText}" Style="{StaticResource CaptionLabel}" AutomationId="AmountRequirement" />
                    <Label Text="{Binding AmountPreviewLine}" Style="{StaticResource CaptionLabel}" LineBreakMode="CharacterWrap"
                           SemanticProperties.Description="{Binding AmountPreviewDescription}" AutomationId="AmountPreview" />
                    <Label Text="{Binding AmountError}" IsVisible="{Binding HasAmountError}" Style="{StaticResource ErrorLabel}" />
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="8">
                    <Label Style="{StaticResource FieldLabel}">
                        <Label.FormattedText>
                            <FormattedString>
                                <Span Text="Due date " />
                                <Span Text="required" FontFamily="JakartaRegular" FontSize="13"
                                      TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" />
                            </FormattedString>
                        </Label.FormattedText>
                    </Label>
                    <Border Style="{StaticResource FieldBorder}">
                        <Border.Triggers>
                            <DataTrigger TargetType="Border" Binding="{Binding Source={x:Reference DueDatePicker}, Path=IsFocused}" Value="True">
                                <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource FocusLight}, Dark={StaticResource FocusDark}}" />
                                <Setter Property="StrokeThickness" Value="3" />
                            </DataTrigger>
                            <DataTrigger TargetType="Border" Binding="{Binding HasDateError}" Value="True">
                                <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource DestructiveLight}, Dark={StaticResource DestructiveDark}}" />
                                <Setter Property="StrokeThickness" Value="3" />
                            </DataTrigger>
                        </Border.Triggers>
                        <Grid ColumnDefinitions="*,Auto">
                            <DatePicker x:Name="DueDatePicker" Date="{Binding SelectedDate}" Format="dd MMM yyyy"
                                        MinimumDate="0001-01-01" MaximumDate="9999-12-31" IsEnabled="{Binding CanEdit}"
                                        Unfocused="OnDateUnfocused" SemanticProperties.Description="Due date, required" />
                            <pages:Glyph Grid.Column="1" Kind="calendar" Size="20" VerticalOptions="Center" Margin="0,0,4,0"
                                         Color="{AppThemeBinding Light={StaticResource TextLight}, Dark={StaticResource TextDark}}" />
                        </Grid>
                    </Border>
                    <Label Text="{Binding DateHintText}" Style="{StaticResource CaptionLabel}" AutomationId="DateHint" />
                    <Label Text="{Binding DateError}" IsVisible="{Binding HasDateError}" Style="{StaticResource ErrorLabel}" />
                </VerticalStackLayout>

                <!-- F07 recurrence (UX03, RC06): only Bill and Subscription repeat, so the row is hidden otherwise. -->
                <Border Style="{StaticResource SurfaceCard}" Padding="0" IsVisible="{Binding CanChooseRepeat}">
                    <VerticalStackLayout>
                        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10" MinimumHeightRequest="56" Padding="16,0">
                            <Label Text="Repeat" FontFamily="JakartaSemibold" FontSize="16" VerticalOptions="Center"
                                   TextColor="{AppThemeBinding Light={StaticResource TextLight}, Dark={StaticResource TextDark}}" />
                            <Label Grid.Column="1" Text="{Binding RepeatSummary}" Style="{StaticResource CaptionLabel}" VerticalOptions="Center" />
                            <pages:Glyph Grid.Column="2" x:Name="RepeatGlyph" Kind="plus" Size="20" VerticalOptions="Center"
                                         Color="{AppThemeBinding Light={StaticResource TextLight}, Dark={StaticResource TextDark}}" />
                            <Button Grid.ColumnSpan="3" x:Name="RepeatToggle" Style="{StaticResource OverlayButton}" Clicked="OnRepeatToggled"
                                    AutomationId="RepeatRow" SemanticProperties.Description="{Binding RepeatSummary, StringFormat='Repeat, {0}. Shows repeat options'}" />
                        </Grid>
                        <VerticalStackLayout x:Name="RepeatBody" IsVisible="False" Spacing="8" Padding="16,0,16,16">
                            <Border Style="{StaticResource FieldBorder}">
                                <Picker x:Name="RepeatPicker" Title="Choose how often" ItemsSource="{Binding Repeats}"
                                        SelectedItem="{Binding SelectedRepeat}" IsEnabled="{Binding CanEdit}" AutomationId="DueRepeat"
                                        SemanticProperties.Description="Repeat, optional" />
                            </Border>
                            <Label Text="{Binding RepeatHelpText}" Style="{StaticResource CaptionLabel}" AutomationId="RepeatHelp" />
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <Border Style="{StaticResource SurfaceCard}" Padding="0">
                    <VerticalStackLayout>
                        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10" MinimumHeightRequest="56" Padding="16,0">
                            <Label Text="Notes" FontFamily="JakartaSemibold" FontSize="16" VerticalOptions="Center"
                                   TextColor="{AppThemeBinding Light={StaticResource TextLight}, Dark={StaticResource TextDark}}" />
                            <Label Grid.Column="1" Text="{Binding NotesSummary}" Style="{StaticResource CaptionLabel}" VerticalOptions="Center" />
                            <pages:Glyph Grid.Column="2" x:Name="NotesGlyph" Kind="plus" Size="20" VerticalOptions="Center"
                                         Color="{AppThemeBinding Light={StaticResource TextLight}, Dark={StaticResource TextDark}}" />
                            <Button Grid.ColumnSpan="3" x:Name="NotesToggle" Style="{StaticResource OverlayButton}" Clicked="OnNotesToggled"
                                    AutomationId="NotesRow" SemanticProperties.Description="{Binding NotesSummary, StringFormat='Notes, {0}. Shows notes'}" />
                        </Grid>
                        <Border x:Name="NotesBody" IsVisible="False" Style="{StaticResource FieldBorder}" Margin="16,0,16,16">
                            <Border.Triggers>
                                <DataTrigger TargetType="Border" Binding="{Binding Source={x:Reference NotesEditor}, Path=IsFocused}" Value="True">
                                    <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource FocusLight}, Dark={StaticResource FocusDark}}" />
                                    <Setter Property="StrokeThickness" Value="3" />
                                </DataTrigger>
                            </Border.Triggers>
                            <Editor x:Name="NotesEditor" Text="{Binding Notes}" AutoSize="TextChanges" MinimumHeightRequest="96"
                                    Placeholder="A little context for later" IsEnabled="{Binding CanEdit}"
                                    SemanticProperties.Description="Optional notes" />
                        </Border>
                    </VerticalStackLayout>
                </Border>

                <!-- Edit only: payment status as the prototype's check row; it applies on Save. -->
                <Grid ColumnDefinitions="*,Auto" MinimumHeightRequest="48" IsVisible="{Binding IsEditMode}">
                    <Label Text="Paid · applies on Save" FontFamily="JakartaMedium" FontSize="16" VerticalOptions="Center"
                           AutomationProperties.IsInAccessibleTree="False"
                           TextColor="{AppThemeBinding Light={StaticResource TextLight}, Dark={StaticResource TextDark}}" />
                    <CheckBox Grid.Column="1" IsChecked="{Binding IsPaid}" IsEnabled="{Binding CanEdit}" AutomationId="EditorPaid"
                              Color="{AppThemeBinding Light={StaticResource PrimaryLight}, Dark={StaticResource PrimaryDark}}"
                              SemanticProperties.Description="Paid. Applies when you save" />
                </Grid>
                <Label Text="New dues start unpaid." Style="{StaticResource CaptionLabel}" IsVisible="{Binding IsAddMode}" />

                <Border Style="{StaticResource SurfaceCard}" IsVisible="{Binding HasError}">
                    <Label Text="{Binding ErrorMessage}" Style="{StaticResource ErrorLabel}" />
                </Border>
                <VerticalStackLayout Spacing="8" IsVisible="{Binding IsBusy}">
                    <ActivityIndicator IsRunning="{Binding IsBusy}" SemanticProperties.Description="{Binding BusyMessage}" />
                    <Label Text="{Binding BusyMessage}" Style="{StaticResource SupportingLabel}" HorizontalTextAlignment="Center" />
                </VerticalStackLayout>
                <Button Text="Retry loading" Command="{Binding LoadCommand}" IsVisible="{Binding ShowLoadRetry}"
                        Style="{StaticResource SecondaryButton}" />
            </VerticalStackLayout>
        </ScrollView>
        <Grid Grid.Row="2" RowDefinitions="1,Auto"
              BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}">
            <BoxView HeightRequest="1" Color="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}" />
            <Grid Grid.Row="1" x:Name="ActionBar" ColumnDefinitions="*,*" ColumnSpacing="12"
                  SemanticProperties.Description="Form actions">
                <Button Text="{Binding CancelButtonText}" Clicked="OnCancelClicked" IsEnabled="{Binding IsIdle}"
                        Style="{StaticResource SecondaryButton}" AutomationId="EditorCancel" />
                <Button Grid.Column="1" Text="{Binding SaveLabel}" Clicked="OnSaveClicked" IsEnabled="{Binding CanSubmit}"
                        SemanticProperties.Description="{Binding SaveButtonText}" AutomationId="EditorSave" />
            </Grid>
        </Grid>
    </Grid>
</ContentPage>
