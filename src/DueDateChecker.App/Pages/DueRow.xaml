<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:DueDateChecker.App.ViewModels"
             xmlns:pages="clr-namespace:DueDateChecker.App.Pages"
             x:Class="DueDateChecker.App.Pages.DueRow"
             x:DataType="vm:IDueRow">
    <!-- Prototype due row (DESIGN prototype alignment, PA05): type icon in a tinted circle; title,
         "dd MMM · Type" and a repeat line on the left; amount over the plain status on the right;
         a hairline below. The BindingContext is the projected due. -->
    <Grid ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="14" Padding="0,14,0,0"
          MinimumHeightRequest="70" SemanticProperties.Description="{Binding AccessibilityText}">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="Selected">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource SurfaceMutedLight}, Dark={StaticResource SurfaceMutedDark}}" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </VisualStateManager.VisualStateGroups>
        <Border WidthRequest="40" HeightRequest="40" StrokeThickness="0" StrokeShape="Ellipse" VerticalOptions="Start"
                BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceMutedLight}, Dark={StaticResource SurfaceMutedDark}}"
                AutomationProperties.ExcludedWithChildren="True">
            <pages:Glyph Kind="{Binding TypeGlyph}" Size="20" HorizontalOptions="Center" VerticalOptions="Center"
                         Color="{AppThemeBinding Light={StaticResource PrimaryLight}, Dark={StaticResource PrimaryDark}}" />
        </Border>
        <VerticalStackLayout Grid.Column="1" Spacing="3" VerticalOptions="Start">
            <Label Text="{Binding Title}" Style="{StaticResource RowTitle}" />
            <Label Text="{Binding MetaText}" Style="{StaticResource CaptionLabel}" />
            <HorizontalStackLayout Spacing="4" IsVisible="{Binding IsRepeating}">
                <pages:Glyph Kind="repeat" Size="14" VerticalOptions="Center"
                             Color="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" />
                <Label Text="{Binding RepeatLineText}" Style="{StaticResource CaptionLabel}" VerticalOptions="Center" />
            </HorizontalStackLayout>
        </VerticalStackLayout>
        <VerticalStackLayout Grid.Column="2" Spacing="4" HorizontalOptions="End" VerticalOptions="Start" MaximumWidthRequest="168">
            <Label Text="{Binding AmountText}" Style="{StaticResource RowAmount}" HorizontalTextAlignment="End">
                <Label.Triggers>
                    <!-- F07: an absent amount reads as quiet text, not as a figure (prototype "No amount"). -->
                    <DataTrigger TargetType="Label" Binding="{Binding HasAmount}" Value="False">
                        <Setter Property="FontFamily" Value="JakartaRegular" />
                        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" />
                    </DataTrigger>
                </Label.Triggers>
            </Label>
            <pages:StatusLine Status="{Binding StatusText}" HorizontalOptions="End" />
        </VerticalStackLayout>
        <BoxView Grid.Row="1" Grid.ColumnSpan="3" Style="{StaticResource Divider}" Margin="0,14,0,0" />
    </Grid>
</ContentView>
