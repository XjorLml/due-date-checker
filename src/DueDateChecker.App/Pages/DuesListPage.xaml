<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:DueDateChecker.App.ViewModels"
             x:Class="DueDateChecker.App.Pages.DuesListPage"
             x:DataType="vm:DuesListViewModel"
             Title="Your dues">
    <Grid Padding="20" RowDefinitions="Auto,Auto,Auto,Auto,*" RowSpacing="12">
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
            <Label Text="Your dues" FontSize="28" FontAttributes="Bold"
                   VerticalOptions="Center" SemanticProperties.HeadingLevel="Level1" />
            <Button x:Name="AddButton" Grid.Column="1" Text="Add due" IsEnabled="{Binding CanAdd}"
                    Clicked="OnAddClicked" SemanticProperties.Hint="Create a new due" />
        </Grid>
        <Label Grid.Row="1" Text="Soonest due first · Tap a due to edit · Amounts in PHP" />
        <VerticalStackLayout Grid.Row="2" Spacing="8">
            <Label Text="{Binding ErrorMessage}" IsVisible="{Binding HasError}"
                   TextColor="{AppThemeBinding Light=#B3261E, Dark=#FFB4AB}" />
            <Button Text="Refresh / Retry" Command="{Binding LoadCommand}" HorizontalOptions="Start" />
            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}"
                               SemanticProperties.Description="Loading your dues" />
        </VerticalStackLayout>
        <VerticalStackLayout Grid.Row="3" IsVisible="{Binding IsEmpty}" Spacing="6" Padding="0,20">
            <Label Text="No dues yet" FontSize="22" FontAttributes="Bold" />
            <Label Text="Add a due to keep track of what you need to pay." />
        </VerticalStackLayout>
        <CollectionView x:Name="DuesCollection" Grid.Row="4" ItemsSource="{Binding Dues}"
                        SelectionMode="Single" SelectionChanged="OnDueSelected" IsEnabled="{Binding CanAdd}"
                        SemanticProperties.Description="Your saved dues; select a due to edit it">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="vm:DueListItem">
                    <Border Margin="0,0,0,12" Padding="16" StrokeShape="RoundRectangle 12">
                        <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="12" RowSpacing="8">
                            <Label Text="{Binding Title}" FontSize="18" FontAttributes="Bold" LineBreakMode="WordWrap" />
                            <Label Grid.Column="1" Text="{Binding AmountText}" FontAttributes="Bold" VerticalOptions="Start" />
                            <Label Grid.Row="1" Text="{Binding DateText}" />
                            <Label Grid.Row="1" Grid.Column="1" Text="{Binding StatusText}" HorizontalOptions="End" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>
