<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:DueDateChecker.App.ViewModels"
             x:Class="DueDateChecker.App.Pages.DuesListPage"
             x:DataType="vm:DuesListViewModel" Title="Duewise">
    <Shell.TitleView>
        <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
            <Image Source="brand_mark.png" WidthRequest="32" HeightRequest="32"
                   AutomationProperties.IsInAccessibleTree="False" />
            <Label Text="Duewise" FontFamily="JakartaBold" FontSize="20" VerticalOptions="Center" />
        </HorizontalStackLayout>
    </Shell.TitleView>
    <Grid x:Name="PageContent">
        <!-- The header scrolls with the list, so large text never consumes a fixed viewport. -->
        <CollectionView x:Name="DuesCollection" ItemsSource="{Binding Dues}"
                        SelectionMode="Single" SelectionChanged="OnDueSelected"
                        SemanticProperties.Description="Your saved dues; select a due to view its details">
            <CollectionView.Header>
                <VerticalStackLayout Spacing="16" Padding="0,8,0,24">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="Your dues" Style="{StaticResource Heading1}" />
                        <Button Text="Settings" Clicked="OnSettingsClicked" Style="{StaticResource SecondaryButton}" SemanticProperties.Hint="Set appearance and calendar preferences" AutomationId="OpenSettings" />
                        <Button Text="Reminders" Clicked="OnRemindersClicked" Style="{StaticResource SecondaryButton}" SemanticProperties.Hint="Set up optional local due-date reminders" />
                        <Label Text="Keep track of what you need to pay, one due at a time."
                               Style="{StaticResource SupportingLabel}" />
                    </VerticalStackLayout>
                    <Button x:Name="AddButton" Text="Add due" IsEnabled="{Binding CanAdd}"
                            Clicked="OnAddClicked" SemanticProperties.Hint="Create a new due" />
                    <Border Style="{StaticResource SurfaceCard}" IsVisible="{Binding HasError}">
                        <Label Text="{Binding ErrorMessage}" Style="{StaticResource ErrorLabel}" />
                    </Border>
                    <Button Text="Refresh / Retry" Command="{Binding LoadCommand}" Style="{StaticResource SecondaryButton}" />
                    <VerticalStackLayout Spacing="8" IsVisible="{Binding IsBusy}">
                        <ActivityIndicator IsRunning="{Binding IsBusy}" SemanticProperties.Description="Loading your dues" />
                        <Label Text="Loading your dues…" Style="{StaticResource SupportingLabel}" HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>
                    <Label Text="Soonest due first · Amounts in PHP · Tap a due for details"
                           Style="{StaticResource CaptionLabel}" />
                </VerticalStackLayout>
            </CollectionView.Header>
            <CollectionView.EmptyView>
                <Border Style="{StaticResource SurfaceCard}" IsVisible="{Binding IsEmpty}">
                    <VerticalStackLayout Spacing="16" Padding="8,16">
                        <Image Source="brand_mark.png" WidthRequest="56" HeightRequest="56" HorizontalOptions="Start"
                               AutomationProperties.IsInAccessibleTree="False" />
                        <Label Text="A little clarity starts here" Style="{StaticResource Heading2}" />
                        <Label Text="No dues yet. Add your first due using the Add due button above."
                               Style="{StaticResource SupportingLabel}" />
                    </VerticalStackLayout>
                </Border>
            </CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="vm:DueListItem">
                    <Border Style="{StaticResource DueCard}" SemanticProperties.Description="{Binding AccessibilityText}">
                        <VerticalStackLayout Spacing="8">
                            <Label Text="{Binding Title}" Style="{StaticResource Heading3}" />
                            <Label Text="{Binding CategoryText}" Style="{StaticResource CaptionLabel}" />
                            <Label Text="{Binding AmountText}" Style="{StaticResource Heading2}"
                                   LineBreakMode="CharacterWrap" />
                            <Label Text="{Binding DateText, StringFormat='Due {0}'}" Style="{StaticResource SupportingLabel}" />
                            <Border Padding="8,4" StrokeThickness="0" StrokeShape="RoundRectangle 16"
                                    HorizontalOptions="Start"
                                    BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceMutedLight}, Dark={StaticResource SurfaceMutedDark}}">
                                <Border.Triggers>
                                    <DataTrigger TargetType="Border" Binding="{Binding Due.IsPaid}" Value="True">
                                        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource PaidSurfaceLight}, Dark={StaticResource PaidSurfaceDark}}" />
                                    </DataTrigger>
                                </Border.Triggers>
                                <HorizontalStackLayout Spacing="8">
                                    <Label Text="○" AutomationProperties.IsInAccessibleTree="False">
                                        <Label.Triggers>
                                            <DataTrigger TargetType="Label" Binding="{Binding Due.IsPaid}" Value="True">
                                                <Setter Property="Text" Value="✓" />
                                                <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource CompletedLight}, Dark={StaticResource CompletedDark}}" />
                                            </DataTrigger>
                                        </Label.Triggers>
                                    </Label>
                                    <Label Text="{Binding StatusText}" FontFamily="JakartaMedium">
                                        <Label.Triggers>
                                            <DataTrigger TargetType="Label" Binding="{Binding Due.IsPaid}" Value="True">
                                                <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource CompletedLight}, Dark={StaticResource CompletedDark}}" />
                                            </DataTrigger>
                                        </Label.Triggers>
                                    </Label>
                                </HorizontalStackLayout>
                            </Border>
                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>
