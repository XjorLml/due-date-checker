<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:DueDateChecker.App.ViewModels"
             x:Class="DueDateChecker.App.Pages.DuesListPage"
             xmlns:pages="clr-namespace:DueDateChecker.App.Pages"
             x:DataType="vm:DuesListViewModel" Title="Duewise" Shell.NavBarIsVisible="False">
    <Grid x:Name="PageContent">
        <!-- The header scrolls with the list, so large text never consumes a fixed viewport. -->
        <CollectionView x:Name="DuesCollection" ItemsSource="{Binding Dues}"
                        SelectionMode="Single" SelectionChanged="OnDueSelected"
                        SemanticProperties.Description="Your saved dues; select a due to view its details">
            <CollectionView.Header>
                <VerticalStackLayout Spacing="16" Padding="0,8,0,0">
                    <HorizontalStackLayout Spacing="8" SemanticProperties.Description="Duewise">
                        <Image Source="brand_mark.png" WidthRequest="28" HeightRequest="28" VerticalOptions="Center"
                               AutomationProperties.IsInAccessibleTree="False" />
                        <Label Text="Duewise" FontFamily="JakartaBold" FontSize="16" VerticalOptions="Center"
                               AutomationProperties.IsInAccessibleTree="False" />
                    </HorizontalStackLayout>
                    <VerticalStackLayout Spacing="6">
                        <Label Text="Your dues." Style="{StaticResource Heading1}" />
                        <Label Text="Date order · all active saved dues · amounts in PHP" Style="{StaticResource CaptionLabel}" />
                    </VerticalStackLayout>
                    <Button Text="Reminders" Clicked="OnRemindersClicked" Style="{StaticResource FilterChip}" HorizontalOptions="Start"
                            SemanticProperties.Hint="Set up optional local due-date reminders" />
                    <Border Style="{StaticResource SurfaceCard}" IsVisible="{Binding HasError}">
                        <VerticalStackLayout Spacing="12">
                            <Label Text="{Binding ErrorMessage}" Style="{StaticResource ErrorLabel}" />
                            <Button Text="Refresh / Retry" Command="{Binding LoadCommand}" Style="{StaticResource SecondaryButton}" HorizontalOptions="Start" />
                        </VerticalStackLayout>
                    </Border>
                    <VerticalStackLayout Spacing="8" IsVisible="{Binding IsBusy}">
                        <ActivityIndicator IsRunning="{Binding IsBusy}" SemanticProperties.Description="Loading your dues" />
                        <Label Text="Loading your dues…" Style="{StaticResource SupportingLabel}" HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>
                    <BoxView Style="{StaticResource Divider}" />
                </VerticalStackLayout>
            </CollectionView.Header>
            <CollectionView.EmptyView>
                <Border Style="{StaticResource SurfaceCard}" IsVisible="{Binding IsEmpty}" Margin="0,16,0,0">
                    <VerticalStackLayout Spacing="16" Padding="8,16">
                        <Image Source="brand_mark.png" WidthRequest="56" HeightRequest="56" HorizontalOptions="Start"
                               AutomationProperties.IsInAccessibleTree="False" />
                        <Label Text="Room for your first due." Style="{StaticResource Heading2}" />
                        <Label Text="No dues yet. Tap Add in the bottom bar to add a bill, subscription or task."
                               Style="{StaticResource SupportingLabel}" />
                    </VerticalStackLayout>
                </Border>
            </CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="vm:DueListItem">
                    <pages:DueRow />
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>
