<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="DueDateChecker.App.Pages.StatusBadge"
             x:Name="Root" HorizontalOptions="Start">
    <!-- DESIGN §7 status badge: one pill for Paid / Overdue / Due today / Upcoming on every surface.
         The word is always present; the glyph and tint only reinforce it. -->
    <Border x:Name="Pill" Padding="10,4" StrokeThickness="0" StrokeShape="RoundRectangle 16"
            BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceMutedLight}, Dark={StaticResource SurfaceMutedDark}}"
            SemanticProperties.Description="{Binding Source={x:Reference Root}, Path=Status, StringFormat='Status: {0}'}">
        <Border.Triggers>
            <DataTrigger TargetType="Border" Binding="{Binding Source={x:Reference Root}, Path=Status}" Value="Paid">
                <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource PaidSurfaceLight}, Dark={StaticResource PaidSurfaceDark}}" />
            </DataTrigger>
            <DataTrigger TargetType="Border" Binding="{Binding Source={x:Reference Root}, Path=Status}" Value="Overdue">
                <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource OverdueSurfaceLight}, Dark={StaticResource OverdueSurfaceDark}}" />
            </DataTrigger>
            <DataTrigger TargetType="Border" Binding="{Binding Source={x:Reference Root}, Path=Status}" Value="Due today">
                <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource DueSoonSurfaceLight}, Dark={StaticResource DueSoonSurfaceDark}}" />
            </DataTrigger>
        </Border.Triggers>
        <HorizontalStackLayout Spacing="6">
            <Label x:Name="Glyph" Text="○" FontFamily="JakartaSemibold" VerticalOptions="Center"
                   AutomationProperties.IsInAccessibleTree="False"
                   TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}">
                <Label.Triggers>
                    <DataTrigger TargetType="Label" Binding="{Binding Source={x:Reference Root}, Path=Status}" Value="Paid">
                        <Setter Property="Text" Value="✓" />
                        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource CompletedLight}, Dark={StaticResource CompletedDark}}" />
                    </DataTrigger>
                    <DataTrigger TargetType="Label" Binding="{Binding Source={x:Reference Root}, Path=Status}" Value="Overdue">
                        <Setter Property="Text" Value="!" />
                        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource DestructiveLight}, Dark={StaticResource DestructiveDark}}" />
                    </DataTrigger>
                    <DataTrigger TargetType="Label" Binding="{Binding Source={x:Reference Root}, Path=Status}" Value="Due today">
                        <Setter Property="Text" Value="●" />
                        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource DueSoonLight}, Dark={StaticResource DueSoonDark}}" />
                    </DataTrigger>
                </Label.Triggers>
            </Label>
            <Label x:Name="Word" Text="{Binding Source={x:Reference Root}, Path=Status}" FontFamily="JakartaMedium" VerticalOptions="Center"
                   AutomationProperties.IsInAccessibleTree="False"
                   TextColor="{AppThemeBinding Light={StaticResource TextLight}, Dark={StaticResource TextDark}}">
                <Label.Triggers>
                    <DataTrigger TargetType="Label" Binding="{Binding Source={x:Reference Root}, Path=Status}" Value="Paid">
                        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource CompletedLight}, Dark={StaticResource CompletedDark}}" />
                    </DataTrigger>
                    <DataTrigger TargetType="Label" Binding="{Binding Source={x:Reference Root}, Path=Status}" Value="Overdue">
                        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource DestructiveLight}, Dark={StaticResource DestructiveDark}}" />
                    </DataTrigger>
                    <DataTrigger TargetType="Label" Binding="{Binding Source={x:Reference Root}, Path=Status}" Value="Due today">
                        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource DueSoonLight}, Dark={StaticResource DueSoonDark}}" />
                    </DataTrigger>
                </Label.Triggers>
            </Label>
        </HorizontalStackLayout>
    </Border>
</ContentView>
