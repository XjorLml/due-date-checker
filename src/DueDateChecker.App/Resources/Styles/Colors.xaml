<?xml version="1.0" encoding="utf-8" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">
    <!-- DESIGN §3 semantic pairs; PaidSurface is a 10% completed tint over surface. -->
    <Color x:Key="BackgroundLight">#F8FAFC</Color>
    <Color x:Key="BackgroundDark">#0B1220</Color>
    <Color x:Key="SurfaceLight">#FFFFFF</Color>
    <Color x:Key="SurfaceDark">#111C30</Color>
    <Color x:Key="SurfaceRaisedLight">#FFFFFF</Color>
    <Color x:Key="SurfaceRaisedDark">#1E293B</Color>
    <Color x:Key="SurfaceMutedLight">#F1F5F9</Color>
    <Color x:Key="SurfaceMutedDark">#25334A</Color>
    <Color x:Key="TextLight">#0F172A</Color>
    <Color x:Key="TextDark">#F8FAFC</Color>
    <Color x:Key="TextSecondaryLight">#475569</Color>
    <Color x:Key="TextSecondaryDark">#CBD5E1</Color>
    <Color x:Key="BorderLight">#CBD5E1</Color>
    <Color x:Key="BorderDark">#64748B</Color>
    <Color x:Key="PrimaryLight">#4338CA</Color>
    <Color x:Key="PrimaryDark">#A5B4FC</Color>
    <Color x:Key="OnPrimaryLight">#FFFFFF</Color>
    <Color x:Key="OnPrimaryDark">#0F172A</Color>
    <Color x:Key="DestructiveLight">#B42332</Color>
    <Color x:Key="DestructiveDark">#FDA4AF</Color>
    <Color x:Key="DueSoonLight">#92400E</Color>
    <Color x:Key="DueSoonDark">#FCD34D</Color>
    <Color x:Key="CompletedLight">#166534</Color>
    <Color x:Key="CompletedDark">#86EFAC</Color>
    <Color x:Key="InfoLight">#1D4ED8</Color>
    <Color x:Key="InfoDark">#93C5FD</Color>
    <Color x:Key="FocusLight">#2563EB</Color>
    <Color x:Key="FocusDark">#93C5FD</Color>
    <Color x:Key="DisabledLight">#64748B</Color>
    <Color x:Key="DisabledDark">#94A3B8</Color>
    <Color x:Key="PaidSurfaceLight">#E8F0EB</Color>
    <Color x:Key="PaidSurfaceDark">#1D313C</Color>
</ResourceDictionary>
