<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <Using Include="Xunit" />
    <ProjectReference Include="../../src/DueDateChecker.Core/DueDateChecker.Core.csproj" />
    <!-- Exercise the actual platform-independent App code without booting MAUI. -->
    <Compile Include="../../src/DueDateChecker.App/Services/DatabaseDispatcher.cs" Link="App/DatabaseDispatcher.cs" />
    <Compile Include="../../src/DueDateChecker.App/Services/AppPreferencesService.cs" Link="App/AppPreferencesService.cs" />
    <Compile Include="../../src/DueDateChecker.App/Services/IReminderPlatform.cs" Link="App/IReminderPlatform.cs" />
    <Compile Include="../../src/DueDateChecker.App/Services/ReminderCoordinator.cs" Link="App/ReminderCoordinator.cs" />
    <Compile Include="../../src/DueDateChecker.App/Services/ReminderJobDispatch.cs" Link="App/ReminderJobDispatch.cs" />
    <Compile Include="../../src/DueDateChecker.App/Services/ReminderAwareDueRepository.cs" Link="App/ReminderAwareDueRepository.cs" />
    <Compile Include="../../src/DueDateChecker.App/ViewModels/*.cs" Link="App/%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
